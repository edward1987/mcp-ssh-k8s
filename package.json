{
  "name": "mcp-ssh-k8s",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.22.2 <25 || >=26.13.0 <27"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc && node scripts/integrity.mjs create",
    "start": "node scripts/start.mjs",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:container": "node scripts/test-container.mjs",
    "test:k8s": "node scripts/test-k8s.mjs",
    "bootstrap": "node scripts/bootstrap.mjs",
    "release:windows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/windows/build-release.ps1"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "acme-client": "^5.4.0",
    "express": "^5.3.0",
    "otpauth": "^9.5.2",
    "ssh2": "^1.17.0",
    "tweetnacl": "^1.0.3",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/ssh2": "^1.15.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
